# Machine-local Magic Set Editor configuration
.env
.env.*.tmp
.mse_launcher.log

# Vendored Magic Set Editor payload. MSE/manifest.json pins it by sha256; the
# files themselves are GPL binaries and third-party frame art/fonts this CC0
# repository cannot redistribute. Populate with launcher/setup_mse.py --source.
/MSE/*
!/MSE/manifest.json
!/MSE/README.md

# Python bytecode
__pycache__/
*.py[cod]
.pytest_cache/

# Website dependencies, generated content, and browser output
website/node_modules/
website/.astro/
website/dist*/
website/public/generated/
website/src/generated/
website/playwright-report/
website/test-results/
website/coverage/

# One-off print output
/print/

# Agent run-state scratch
.agentsystem/

# graphify knowledge graph output
graphify-out/

# Working scratch: progress notes, one-off exports, downloaded archives
.tmp/

# impeccable design-hook cache
.impeccable/

# Astro CLI run-state (background dev server log)
.astro/

# pi.dev / subagent tool run artifacts (debug transcripts, ad-hoc HTML views)
.pi/artifacts/
.pi-subagents/artifacts/
**/.pi/artifacts/
