---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CardPicture from '../../../../components/CardPicture.astro';
import ImageZoom from '../../../../components/ImageZoom.svelte';
import RichText from '../../../../components/RichText.astro';
import {
  catalog,
  cardsById,
  formatDate,
  withBase,
} from '../../../../lib/catalog';

export function getStaticPaths() {
  return catalog.cardVersions.map((card) => ({
    params: { id: card.id, package: card.packageId },
    props: { card },
  }));
}
const { card } = Astro.props;
const current = cardsById.get(card.id)!;
const base = import.meta.env.BASE_URL;
const zoomImage = withBase(base, card.images.zoom.webp);
---

<BaseLayout
  title={`${card.name} — ${card.stageLabel} ${card.version}`}
  description={`Immutable ${card.stageLabel} ${card.version} version of ${card.name}.`}
  image={card.images.display.webp}
  accent={card.sectionAccent}
  theme={card.sectionSlug}
>
  <article class="page-shell card-detail">
    <div class="render-column">
      <CardPicture
        card={card}
        tier="display"
        eager
        alt={`${card.name} card render from ${card.stageLabel} ${card.version}`}
      />
      <ImageZoom
        client:load
        src={zoomImage}
        alt={`${card.name} card render from ${card.stageLabel} ${card.version}`}
        width={card.width}
        height={card.height}
      />
    </div>
    <div class="card-transcription">
      <p>
        <a href={withBase(base, current.route)}>{card.name}</a> / Immutable version
      </p>
      <h1>{card.name}</h1>
      <p>
        <strong>{card.stageLabel} {card.version}</strong> · Published {
          formatDate(card.releasedOn)
        }
      </p>
      {
        card.castingCost && (
          <p>
            <strong>Cost:</strong> {card.castingCost}
          </p>
        )
      }
      <p class="type-line">
        {card.superType}{card.subType && ` — ${card.subType}`}
      </p>
      <RichText value={card.ruleText} class="rules-text" />
      {
        card.flavorTextPlain && (
          <RichText value={card.flavorText} class="flavor-text" />
        )
      }
      {
        card.power && card.toughness && (
          <p>
            <strong>Power / toughness:</strong> {card.power}/{card.toughness}
          </p>
        )
      }
      <div class="card-facts">
        <span>Rarity: {card.rarity}</span>
        <span>Collection: {card.collectionNumber}</span>
      </div>
      <p>
        <a href={withBase(base, card.releaseRoute)}>View release package</a>
      </p>
      <p><a href={withBase(base, current.route)}>View current card →</a></p>
    </div>
  </article>
</BaseLayout>
