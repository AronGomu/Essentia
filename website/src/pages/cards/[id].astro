---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CardPicture from '../../components/CardPicture.astro';
import Markdown from '../../components/Markdown.astro';
import RichText from '../../components/RichText.astro';
import {
  catalog,
  cardsById,
  sectionsBySlug,
  formatDate,
  withBase,
  previewImage,
  relatedCards,
  essentiaKeywordsFor,
} from '../../lib/catalog';

export function getStaticPaths() {
  return catalog.cards.map((card) => ({
    params: { id: card.id },
    props: { card },
  }));
}
const { card } = Astro.props;
const section = sectionsBySlug.get(card.sectionSlug)!;
const sectionCards = section.cardIds
  .map((id) => cardsById.get(id)!)
  .filter(Boolean);
const index = sectionCards.findIndex((candidate) => candidate.id === card.id);
const previous =
  sectionCards[(index - 1 + sectionCards.length) % sectionCards.length]!;
const next = sectionCards[(index + 1) % sectionCards.length]!;
const related = relatedCards(card, catalog.cards, catalog.keywords);
const base = import.meta.env.BASE_URL;
const explanation = catalog.explanations[card.id];
const ruleDefinitions = new Map(
  catalog.keywords.map((keyword) => [keyword.term, keyword.definition]),
);
const versions = catalog.cardVersions
  .filter((version) => version.id === card.id)
  .sort(
    (a, b) =>
      b.stageRank - a.stageRank || b.releasedOn.localeCompare(a.releasedOn),
  );
---

<BaseLayout
  title={`${card.name} — Essentia`}
  description={`${card.name}: ${card.superType}. ${card.ruleTextPlain.slice(0, 130)}`}
  image={card.images.display.webp}
  accent={section.accent}
  theme={section.slug}
  breadcrumb={[
    { label: 'Archive', href: base },
    { label: section.label, href: withBase(base, section.route) },
    { label: card.name },
  ]}
>
  <article class="page-shell card-detail">
    <div class="render-column">
      <CardPicture
        card={card}
        tier="display"
        eager
        alt={`${card.name} card render`}
      />
    </div>
    <div class="card-transcription">
      <h1>{card.name}</h1>
      {
        card.castingCost && (
          <p>
            <strong>Cost:</strong> {card.castingCost}
          </p>
        )
      }
      <p class="type-line">
        {card.superType}{card.subType && ` — ${card.subType}`}
      </p>
      <RichText
        value={card.ruleText}
        class="rules-text"
        definitions={ruleDefinitions}
      />
      {
        card.flavorTextPlain && (
          <RichText value={card.flavorText} class="flavor-text" />
        )
      }
      {
        card.power && card.toughness && (
          <p>
            <strong>Power / toughness:</strong> {card.power}/{card.toughness}
          </p>
        )
      }
      {
        explanation && (
          <section>
            <>
              <h2>Design notes</h2>
              <Markdown value={explanation} class="authored-explanation" />
            </>
          </section>
        )
      }
      <div class="card-facts">
        <span>Current: {card.stageLabel} {card.version}</span>
        <span>Published {formatDate(card.releasedOn)}</span>
        <span>Rarity: {card.rarity}</span>
        <span>Collection: {card.collectionNumber}</span>
        {card.support && <span>Support card</span>}
      </div>
      <section>
        <h2>Release history</h2>
        <ul>
          {
            versions.map((version) => (
              <li>
                <a href={withBase(base, version.versionRoute)}>
                  {version.stageLabel} {version.version} ·{' '}
                  {formatDate(version.releasedOn)}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
      <nav class="card-pager" aria-label="Cards in manifest order">
        <a href={withBase(base, previous.route)}>← {previous.name}</a><a
          href={withBase(base, next.route)}>{next.name} →</a
        >
      </nav>
      {
        related.length > 0 && (
          <section>
            <h2>Related cards</h2>
            <ul class="related-cards">
              {related.map((item) => (
                <li>
                  <a
                    href={withBase(base, item.route)}
                    data-card-preview={withBase(base, previewImage(item))}
                    data-card-keywords={essentiaKeywordsFor(item)
                      .map((entry) => entry.term)
                      .join(',')}
                  >
                    {item.name}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>
