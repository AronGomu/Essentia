---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CardPicture from '../../components/CardPicture.astro';
import CardGallery from '../../components/CardGallery.astro';
import Markdown from '../../components/Markdown.astro';
import RichText from '../../components/RichText.astro';
import {
  catalog,
  cardsById,
  sectionsBySlug,
  formatDate,
  withBase,
  toGalleryCard,
  previewKeywordsFor,
} from '../../lib/catalog';
import { truncateAtWordBoundary } from '../../lib/text';

export function getStaticPaths() {
  return catalog.cards.map((card) => ({
    params: { id: card.id },
    props: { card },
  }));
}
const { card } = Astro.props;
const section = sectionsBySlug.get(card.sectionSlug)!;
const sectionCards = section.cardIds
  .map((id) => cardsById.get(id)!)
  .filter(Boolean);
const index = sectionCards.findIndex((candidate) => candidate.id === card.id);
const previous =
  sectionCards[(index - 1 + sectionCards.length) % sectionCards.length]!;
const next = sectionCards[(index + 1) % sectionCards.length]!;
const RELATED_CAP = 12;
const archetypeRelated = card.related.archetype
  .map((id) => cardsById.get(id)!)
  .filter(Boolean);
const interactionRelated = card.related.interaction
  .map((id) => cardsById.get(id)!)
  .filter(Boolean);
const rules = previewKeywordsFor(card);
const base = import.meta.env.BASE_URL;
const explanation = catalog.explanations[card.id];
// Same cut as the docs descriptions: a bare slice() lands mid-word, and 35 of
// the 50 cards have rule text longer than the excerpt.
const description = [
  `${card.name}: ${card.superType}.`,
  truncateAtWordBoundary(card.ruleTextPlain, 130),
]
  .filter(Boolean)
  .join(' ');
const versions = catalog.cardVersions
  .filter((version) => version.id === card.id)
  .sort(
    (a, b) =>
      b.stageRank - a.stageRank || b.releasedOn.localeCompare(a.releasedOn),
  );
---

<BaseLayout
  title={`${card.name} — Essentia`}
  description={description}
  image={card.images.display.webp}
  accent={section.accent}
  theme={section.slug}
  breadcrumb={[
    { label: 'Archive', href: base },
    { label: section.label, href: withBase(base, section.route) },
    { label: card.name },
  ]}
>
  <article class="page-shell card-detail">
    <div class="render-column">
      <CardPicture
        card={card}
        tier="display"
        eager
        alt={`${card.name} card render`}
        sizes="(min-width: 70rem) 40rem, 92vw"
      />
      <a
        class="full-size-link"
        href={withBase(base, card.images.print.url)}
        target="_blank"
        rel="noopener"
        aria-label={`Show ${card.name} at full size`}
      >
        Show full size{card.images.print.draftResolution && ' (draft)'}
      </a>
    </div>
    <div class="card-transcription">
      <h1>{card.name}</h1>
      {
        card.castingCost && (
          <p>
            <strong>Cost:</strong> {card.castingCost}
          </p>
        )
      }
      <p class="type-line">
        {card.superType}{card.subType && ` — ${card.subType}`}
      </p>
      <RichText value={card.ruleText} class="rules-text" />
      {
        card.flavorTextPlain && (
          <RichText value={card.flavorText} class="flavor-text" />
        )
      }
      {
        card.power && card.toughness && (
          <p>
            <strong>Power / toughness:</strong> {card.power}/{card.toughness}
          </p>
        )
      }
      <div class="card-facts">
        <span>Current: {card.stageLabel} {card.version}</span>
        <span>Published {formatDate(card.releasedOn)}</span>
        <span>Rarity: {card.rarity}</span>
        <span>Collection: {card.collectionNumber}</span>
        {card.support && <span>Support card</span>}
      </div>
      {
        rules.length > 0 && (
          <section>
            <h2>Rules</h2>
            <dl class="keyword-rules">
              {rules.map((rule) => (
                <>
                  <dt>{rule.term}</dt>
                  <dd>{rule.definition}</dd>
                </>
              ))}
            </dl>
          </section>
        )
      }
      {
        explanation && (
          <section>
            <h2>Design notes</h2>
            <Markdown value={explanation} class="authored-explanation" />
          </section>
        )
      }
      <section>
        <h2>Release history</h2>
        <ul>
          {
            versions.map((version) => (
              <li>
                <a href={withBase(base, version.versionRoute)}>
                  {version.stageLabel} {version.version} ·{' '}
                  {formatDate(version.releasedOn)}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
      <nav class="card-pager" aria-label="Cards in manifest order">
        <a href={withBase(base, previous.route)}>← {previous.name}</a><a
          href={withBase(base, next.route)}>{next.name} →</a
        >
      </nav>
      {
        archetypeRelated.length > 0 && (
          <section aria-labelledby="related-archetype">
            <h2 id="related-archetype">Same archetype</h2>
            <CardGallery
              cards={archetypeRelated.slice(0, RELATED_CAP).map(toGalleryCard)}
              base={base}
            />
            {archetypeRelated.length > RELATED_CAP && (
              <p class="related-more">
                <a href={withBase(base, section.route)}>
                  View all {archetypeRelated.length} {section.label} cards
                </a>
              </p>
            )}
          </section>
        )
      }
      {
        interactionRelated.length > 0 && (
          <section aria-labelledby="related-interaction">
            <h2 id="related-interaction">Interacts with this card</h2>
            <CardGallery
              cards={interactionRelated
                .slice(0, RELATED_CAP)
                .map(toGalleryCard)}
              base={base}
            />
            {interactionRelated.length > RELATED_CAP && (
              <p class="related-more">
                {interactionRelated.length - RELATED_CAP} more
              </p>
            )}
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>
