---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Markdown from '../../components/Markdown.astro';
import ChapterSummary from '../../components/ChapterSummary.astro';
import { catalog, withBase, type CatalogDoc } from '../../lib/catalog';
import { docDescription } from '../../lib/docs';

export function getStaticPaths() {
  return catalog.docs
    .filter((doc) => doc.route !== '/docs/')
    .map((doc) => ({
      params: { path: doc.route.slice('/docs/'.length).replace(/\/$/, '') },
      props: { doc },
    }));
}

interface Props {
  doc: CatalogDoc;
}

const { doc } = Astro.props;
const base = import.meta.env.BASE_URL;
const chapters = doc.headings
  .filter((heading) => heading.level === 2)
  .map((heading) => ({ href: `#${heading.id}`, label: heading.text }));
const description = docDescription(doc.body);
---

<BaseLayout
  title={`${doc.title} — Essentia`}
  description={description}
  breadcrumb={[
    { label: 'Archive', href: base },
    { label: 'Docs', href: withBase(base, 'docs/') },
    { label: doc.title },
  ]}
>
  <div class="reading-shell">
    <article class="reading-body docs-body">
      <h1>{doc.title}</h1>
      <Markdown value={doc.body} />
    </article>
    <ChapterSummary items={chapters} />
  </div>
</BaseLayout>
