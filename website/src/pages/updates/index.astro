---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CardPicture from '../../components/CardPicture.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import {
  catalog,
  cardsById,
  sectionsBySlug,
  withBase,
  formatDate,
} from '../../lib/catalog';
const base = import.meta.env.BASE_URL;
const updates = catalog.updates.map((update) => ({
  ...update,
  card: cardsById.get(update.cardId)!,
  section: sectionsBySlug.get(update.sectionSlug)!,
}));
---

<BaseLayout
  title="Card updates — Essentia"
  description="New and meaningfully updated cards across the Essentia cube catalog."
  theme="home"
>
  <div class="page-shell">
    <header class="section-heading">
      <div>
        <h1>Card updates</h1><p>
          Canonical feed for new and meaningfully changed cards across all
          published sections.
        </p>
      </div>
    </header>
    <ul class="update-list">
      {
        updates.length === 0 ? (
          <li>No immutable releases published yet.</li>
        ) : (
          updates.map(
            ({ card, section, status, modified, versionRoute }, index) => (
              <li class="update-item">
                <a
                  href={withBase(base, versionRoute)}
                  data-card-preview={withBase(base, card.render)}
                >
                  <>
                    <CardPicture {card} eager={index < 3} />
                    <span class="update-meta">
                      <>
                        <span>
                          <>
                            <strong>{card.name}</strong>
                            <small>
                              {section.label} · {formatDate(modified)}
                            </small>
                          </>
                        </span>
                        <StatusBadge {status} />
                      </>
                    </span>
                  </>
                </a>
              </li>
            ),
          )
        )
      }
    </ul>
  </div>
</BaseLayout>
