---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardPicture from '../components/CardPicture.astro';
import StatusBadge from '../components/StatusBadge.astro';
import {
  catalog,
  cardsById,
  previewKeywordsFor,
  previewImage,
  withBase,
  formatDate,
  sectionHasNewCards,
} from '../lib/catalog';

const base = import.meta.env.BASE_URL;
const latest = catalog.updates
  .filter((update) => update.status === 'new')
  .map((update) => ({ ...update, card: cardsById.get(update.cardId)! }));
const newCardCount = latest.length;
const newCards = latest.slice(0, 10);
const heroImage = catalog.projectHeroImage;
const hasPublication = Boolean(
  catalog.sections.length && catalog.releases.length,
);
---

<BaseLayout
  title="Essentia — The Blackfoil Archive"
  description="Essentia preserves Yu-Gi-Oh! gameplay identities inside Magic's card-game rules."
  {...heroImage ? { image: heroImage } : {}}
  accent="relic"
  theme="home"
>
  {
    hasPublication ? (
      <>
        <section class="hero">
          <img
            class="hero-art"
            src={withBase(base, heroImage)}
            alt=""
            width="1672"
            height="941"
            fetchpriority="high"
          />
          <div class="hero-content">
            <h1>
              The <span class="hero-accent-ygo">Yu-Gi-Oh!</span> Feel.
              <br />
              With <span class="hero-accent-mtg">Magic</span>{' '}
              <span class="hero-underline">Rules.</span>
            </h1>
            <p>
              Discover the best Yu-Gi-Oh has to offer within MTG game system.
            </p>
            <div class="hero-actions">
              <a class="primary-link" href={withBase(base, '/docs/')}>
                Learn about Essentia
              </a>
              <a class="secondary-link" href={withBase(base, '/updates/')}>
                View new cards
              </a>
            </div>
          </div>
        </section>

        <section
          class="page-shell new-cards-shell"
          aria-labelledby="new-cards-heading"
        >
          <div class="section-heading">
            <div>
              <h2 id="new-cards-heading">New cards</h2>
            </div>
          </div>
          <ul class="new-card-grid" aria-label="New cards">
            {newCards.map(({ card, status }, index) => (
              <li class="new-card-item">
                <a
                  href={withBase(base, card.route)}
                  data-card-preview={withBase(base, previewImage(card))}
                  data-card-keywords={previewKeywordsFor(card)
                    .map((entry) => entry.term)
                    .join(',')}
                >
                  <CardPicture card={card} eager={index < 5} />
                  <span class="update-meta">
                    <span>
                      <strong>{card.name}</strong>
                      <small>{formatDate(card.releasedOn)}</small>
                    </span>
                    <StatusBadge status={status} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <p class="new-card-more">
            <a class="primary-link" href={withBase(base, '/updates/')}>
              View all {newCardCount} new cards
            </a>
          </p>
        </section>

        <section aria-labelledby="catalog-heading">
          <div class="page-shell section-heading catalog-shell">
            <div>
              <h2 id="catalog-heading">Archetypes</h2>
            </div>
          </div>
          <div class="section-menu">
            {catalog.sections.map((section) => (
              <a class="section-tile" href={withBase(base, section.route)}>
                {sectionHasNewCards(section) && (
                  <span class="tile-badge">New</span>
                )}
                <img
                  src={withBase(base, section.heroImage)}
                  alt=""
                  width="624"
                  height="624"
                  loading="lazy"
                />
                <div>
                  <h3>{section.label}</h3>
                  <p>
                    {section.count} published cards · Updated{' '}
                    {formatDate(section.latestModified)}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </section>
      </>
    ) : (
      <section
        class="page-shell empty-publication"
        aria-labelledby="empty-title"
      >
        <p class="eyebrow">Publication archive</p>
        <h1 id="empty-title">No release packages published yet.</h1>
        <p>
          Editable staging projects exist, but this website publishes only
          Alpha, Beta, and Release packages. Legend of the Alpha (LOTA-0001)
          Alpha_0.1 is open under alpha.
        </p>
        <div class="hero-actions">
          <a class="primary-link" href={withBase(base, '/docs/')}>
            Learn about Essentia
          </a>
          <a class="secondary-link" href={withBase(base, '/rules/')}>
            Read cube rules
          </a>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .empty-publication {
    min-height: 60vh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1rem;
    max-width: 54rem;
  }
  .empty-publication h1,
  .empty-publication p {
    margin: 0;
  }
  .empty-publication > p:not(.eyebrow) {
    max-width: 44rem;
    color: var(--muted);
  }
  .new-cards-shell {
    padding-block-start: var(--space-5);
  }
  .new-cards-shell .section-heading {
    margin-bottom: var(--space-2);
  }
  .catalog-shell.section-heading {
    margin-bottom: var(--space-2);
    /* This div also carries `.page-shell`, whose padding-block puts up to
       7rem of padding below the heading too — kill only that half so the
       tiles sit close, keeping the top half for separation from New cards. */
    padding-block-end: 0;
  }
  /* h2's UA default margin sits inside the flex item's own block formatting
     context (a flex item does not let its child's margin collapse through),
     so it was adding to these wrappers' height on top of the margin-bottom
     above. Zero it so the wrapper's own margin-bottom is the whole gap. */
  .new-cards-shell .section-heading h2,
  .catalog-shell.section-heading h2 {
    margin: 0;
  }
</style>
