---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardPicture from '../components/CardPicture.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { catalog, cardsById, withBase, formatDate } from '../lib/catalog';

const base = import.meta.env.BASE_URL;
const latest = catalog.updates
  .filter((update) => update.status === 'new')
  .map((update) => ({ ...update, card: cardsById.get(update.cardId)! }));
const heroSection = catalog.sections[0];
const heroImage = heroSection?.image;
const heroRoute = heroSection?.route ?? '/';
const heroLabel = heroSection?.label ?? 'published cards';
const hasPublication = Boolean(heroSection && catalog.releases.length);
---

<BaseLayout
  title="Essentia — The Blackfoil Archive"
  description="Essentia preserves Yu-Gi-Oh! gameplay identities inside Magic's card-game rules."
  {...heroImage ? { image: heroImage } : {}}
  accent="relic"
  theme="home"
>
  {
    hasPublication ? (
      <>
        <section class="hero">
          <img
            class="hero-art"
            src={withBase(base, heroImage ?? '')}
            alt=""
            width="1200"
            height="800"
            fetchpriority="high"
          />
          <div class="hero-content">
            <h1>
              Yu-Gi-Oh! feel.
              <br />
              Playable under Magic rules.
            </h1>
            <p>
              Source-backed cards, release history, canonical renders,
              readable rules, and stable card pages.
            </p>
            <div class="hero-actions">
              <a class="primary-link" href={withBase(base, heroRoute)}>
                Explore {heroLabel}
              </a>
              <a class="secondary-link" href={withBase(base, '/updates/')}>
                See what changed
              </a>
            </div>
          </div>
        </section>

        <section class="page-shell" aria-labelledby="new-cards-heading">
          <div class="section-heading">
            <div>
              <h2 id="new-cards-heading">New cards</h2>
              <p>Latest cards from alpha/beta/release packages.</p>
            </div>
            <a href={withBase(base, '/updates/')}>View all updates</a>
          </div>
          <ul class="update-list new-card-carousel" aria-label="New cards">
            {latest.map(({ card, status }, index) => (
              <li class="update-item">
                <a
                  href={withBase(base, card.route)}
                  data-card-preview={withBase(base, card.render)}
                >
                  <CardPicture card={card} eager={index < 3} />
                  <span class="update-meta">
                    <span>
                      <strong>{card.name}</strong>
                      <small>{formatDate(card.releasedOn)}</small>
                    </span>
                    <StatusBadge status={status} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="catalog-heading">
          <div class="page-shell section-heading">
            <div>
              <h2 id="catalog-heading">Published sections</h2>
              <p>Current card versions selected from lifecycle metadata.</p>
            </div>
          </div>
          <div class="section-menu">
            {catalog.sections.map((section) => (
              <a class="section-tile" href={withBase(base, section.route)}>
                <img
                  src={withBase(base, section.image)}
                  alt=""
                  width="1200"
                  height="800"
                  loading="lazy"
                />
                <div>
                  <h3>{section.label}</h3>
                  <p>
                    {section.count} published cards · Updated{' '}
                    {formatDate(section.latestModified)}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </section>
      </>
    ) : (
      <section
        class="page-shell empty-publication"
        aria-labelledby="empty-title"
      >
        <p class="eyebrow">Publication archive</p>
        <h1 id="empty-title">No release packages published yet.</h1>
        <p>
          Editable staging projects exist, but this website publishes only
          Alpha, Beta, and Release packages. Legend of the Alpha (LOTA-0001)
          Alpha_0.1 is open under alpha.
        </p>
        <div class="hero-actions">
          <a class="primary-link" href={withBase(base, '/philosophy/')}>
            Read design philosophy
          </a>
          <a class="secondary-link" href={withBase(base, '/rules/')}>
            Read cube rules
          </a>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .empty-publication {
    min-height: 60vh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1rem;
    max-width: 54rem;
  }
  .empty-publication h1,
  .empty-publication p {
    margin: 0;
  }
  .empty-publication > p:not(.eyebrow) {
    max-width: 44rem;
    color: var(--muted);
  }
</style>
