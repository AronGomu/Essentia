---
// GitHub Pages serves this document for every unknown path, so it is the
// most-reachable URL on the site. It deliberately does not use BaseLayout — a
// redirect stub wants no header, breadcrumb or hover preview — which is how it
// came to be the one page shipping no policy at all. The CSP below is
// therefore inlined here; harden-csp.mjs rewrites its two inline-allowing
// placeholders into content hashes exactly as it does for every other page.
// Keep those placeholder tokens out of any emitted HTML comment: harden-csp
// scans the whole document afterwards and fails if one survives.
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-src 'none'; manifest-src 'self'"
    />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${base}`} />
    <link rel="canonical" href={new URL(base, Astro.site)} />
    <title>Redirecting — Essentia</title>
  </head>
  <body
    ><p>
      This route is not part of the archive. <a href={base}
        >Continue to the Essentia home page</a
      >.
    </p></body
  >
</html>
