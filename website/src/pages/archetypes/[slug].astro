---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CardGallery from '../../components/CardGallery.astro';
import {
  catalog,
  cardsById,
  formatDate,
  toGalleryCard,
  withBase,
} from '../../lib/catalog';

export function getStaticPaths() {
  return catalog.sections
    .filter((section) => section.kind === 'archetype')
    .map((section) => ({ params: { slug: section.slug }, props: { section } }));
}
const { section } = Astro.props;
const cards = section.cardIds.map((id: string) =>
  toGalleryCard(cardsById.get(id)!),
);
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title={`${section.label} cards — Essentia`}
  description={section.intro}
  image={section.image}
  accent={section.accent}
  theme={section.slug}
  breadcrumb={[
    { label: 'Archive', href: base },
    { label: 'Archetypes' },
    { label: section.label },
  ]}
>
  <div class="page-shell">
    <section class="catalog-hero">
      <div>
        <h1>{section.label}</h1><p>
          {section.intro}
        </p><div class="catalog-stats">
          <span><strong>{section.count}</strong> published cards</span>{
            section.latestModified && (
              <span>
                Latest release{' '}
                <strong>{formatDate(section.latestModified)}</strong>
              </span>
            )
          }
        </div>
      </div>
      <div class="catalog-hero-art">
        <img
          src={withBase(base, section.heroImage)}
          alt={`${section.label} iconic card artwork`}
          width="624"
          height="624"
          fetchpriority="high"
        />
      </div>
    </section>
    <CardGallery {cards} {base} />
  </div>
</BaseLayout>
