---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { catalog, formatDate, withBase } from '../../lib/catalog';

const base = import.meta.env.BASE_URL;
const posts = catalog.posts;
---

<BaseLayout
  title="Blog — Essentia"
  description="Announcements and design notes from the Essentia project."
  accent="relic"
  breadcrumb={[{ label: 'Archive', href: base }, { label: 'Blog' }]}
>
  <div class="page-shell">
    <h1>Blog</h1>
    {
      posts.length === 0 ? (
        <p>No posts published yet.</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a href={withBase(base, post.route)}>
                <h2>{post.title}</h2>
              </a>
              <p class="post-meta">
                {formatDate(post.date)} · {post.author}
              </p>
              <p>{post.summary}</p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
