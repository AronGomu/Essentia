---
import ChapterSummary from '../../components/ChapterSummary.astro';
import Markdown from '../../components/Markdown.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { catalog, formatDate, latestPost, withBase } from '../../lib/catalog';

const base = import.meta.env.BASE_URL;
const post = latestPost(catalog);
const chapters =
  post?.headings
    .filter((heading) => heading.level === 2)
    .map((heading) => ({
      href: '#' + heading.id,
      label: heading.text,
    })) ?? [];
const shellClass = chapters.length
  ? 'reading-shell'
  : 'reading-shell reading-shell--no-toc';
---

<BaseLayout
  title={post ? `${post.title} — Essentia` : 'Blog — Essentia'}
  description={post?.summary ??
    'Announcements and design notes from the Essentia project.'}
  canonicalPath={post ? withBase(base, post.route) : undefined}
  accent="relic"
  breadcrumb={[{ label: 'Archive', href: base }, { label: 'Blog' }]}
>
  <div class={shellClass}>
    <article class="reading-body post-body">
      {
        post ? (
          <>
            <h1>{post.title}</h1>
            <p class="post-meta">
              {formatDate(post.date)} · {post.author}
            </p>
            <Markdown value={post.body} />
          </>
        ) : (
          <p>No posts published yet.</p>
        )
      }
    </article>
    {chapters.length > 0 && <ChapterSummary items={chapters} />}
  </div>
</BaseLayout>
