---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Markdown from '../../components/Markdown.astro';
import BlogRail from '../../components/BlogRail.astro';
import {
  catalog,
  formatDate,
  withBase,
  type CatalogPost,
} from '../../lib/catalog';

export function getStaticPaths() {
  return catalog.posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CatalogPost;
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title={`${post.title} — Essentia`}
  description={post.summary}
  accent="relic"
  breadcrumb={[
    { label: 'Archive', href: base },
    { label: 'Blog', href: withBase(base, 'blog/') },
    { label: post.title },
  ]}
>
  <div class="reading-shell reading-shell--no-toc">
    <BlogRail posts={catalog.posts} currentRoute={post.route} {base} />
    <article class="reading-body post-body">
      <h1>{post.title}</h1>
      <p class="post-meta">
        {formatDate(post.date)} · {post.author}
      </p>
      <Markdown value={post.body} />
    </article>
  </div>
</BaseLayout>
