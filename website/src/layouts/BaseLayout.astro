---
import BackToTop from '../components/BackToTop.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CardHoverPreview from '../components/CardHoverPreview.astro';
import CardQualityUpgrade from '../components/CardQualityUpgrade.astro';
import FindPalette from '../components/FindPalette.svelte';
import Navigation from '../components/Navigation.svelte';
import Seo from '../components/Seo.astro';
import { catalog, previewDefinitions, withBase } from '../lib/catalog';
import { buildFindEntries } from '../lib/find';
import { readingKindFor, readingNavGroups } from '../lib/reading-nav';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalPath?: string | undefined;
  accent?: string;
  theme?: string;
  breadcrumb?: Array<{ label: string; href?: string }>;
  page?: string | undefined;
  background?: string | undefined;
}
const {
  title,
  description,
  image,
  canonicalPath = undefined,
  accent = 'relic',
  theme = 'archive',
  breadcrumb,
  page,
  background,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const navSections = catalog.sections.map(
  ({ slug, label, kind, accent, route, count }) => ({
    slug,
    label,
    kind,
    accent,
    route,
    count,
  }),
);
const section = ['docs/', 'blog/', 'decks/'].find((path) =>
  Astro.url.pathname.startsWith(`${base}${path}`),
);
// On docs and blog pages the left rail carries that section's reading
// navigation instead of the card catalog.
const readingKind = readingKindFor(Astro.url.pathname, base);
const readingGroups = readingNavGroups(readingKind, catalog);
// Build-time index only. The visitor's browser-local decks are merged inside
// the island after mount and never travel through here — see `src/lib/find.ts`.
const findEntries = buildFindEntries({
  cards: catalog.cards.map(
    ({ id, name, matchNames, route, sectionLabel, manifestIndex }) => ({
      id,
      name,
      matchNames,
      route,
      sectionLabel,
      manifestIndex,
    }),
  ),
  docs: catalog.docs.map(({ id, title, route, groupLabel }) => ({
    id,
    title,
    route,
    groupLabel,
  })),
  posts: catalog.posts.map(({ slug, title, route, date }) => ({
    slug,
    title,
    route,
    date,
  })),
  releases: catalog.releases.map(({ id, setName, version, route, decks }) => ({
    id,
    setName,
    version,
    route,
    decks,
  })),
});
const keywordRulings = Object.fromEntries(previewDefinitions());
// `set:html` writes this verbatim, so a stray `</script>` in a term or ruling
// would close the JSON block and turn the rest into live markup. `<` only ever
// occurs inside JSON string literals, where the `\u003c` escape means exactly
// the same character — the payload still parses to an identical object. The
// registry loader rejects `<` upstream; this is the second belt.
const keywordRulingsJson = JSON.stringify(keywordRulings).replaceAll(
  '<',
  '\\u003c',
);
---

<!doctype html>
<html
  lang="en"
  data-accent={accent}
  data-theme={theme}
  data-catalog="expanded"
  data-page={page}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="oklch(0.08 0 0)" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={`${base}brand/favicon-32.png`}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href={`${base}brand/favicon-16.png`}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={`${base}brand/apple-touch-icon-180.png`}
    />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-src 'none'; manifest-src 'self'"
    />
    <Seo {title} {description} {image} {canonicalPath} />
    {
      background && (
        <style
          set:html={`html[data-page='archetype'] main { --page-photo: url('${withBase(base, background)}'); }`}
        />
      )
    }
    <script is:inline>
      try {
        if (localStorage.getItem('essentia.v1.catalog-rail') === 'collapsed')
          document.documentElement.dataset.catalog = 'collapsed';
      } catch {
        // Blocked by a privacy setting or a sandboxed context; the rail
        // simply renders expanded, its documented default.
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="compact-brand" href={base}>
        <picture>
          <source
            media="(max-width: 44rem)"
            srcset={`${base}brand/mark-64.png`}
          />
          <img
            src={`${base}brand/wordmark-320.png`}
            alt="Essentia"
            width="320"
            height="74"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
      </a>
      <!-- The hamburger is a header item, not a floating button: the brand must own the top-left corner at every width. Astro's astro-island is display:contents, so the island is transparent to this flex row. -->
      <Navigation
        client:load
        sections={navSections}
        currentPath={Astro.url.pathname}
        {base}
        mode={readingKind ? 'reading' : 'catalog'}
        {readingKind}
        {readingGroups}
      />
      {breadcrumb && <Breadcrumb items={breadcrumb} />}
      <nav class="utility-nav" aria-label="Sections">
        <div class="utility-menu" id="utility-menu">
          <a
            href={`${base}docs/`}
            aria-label="Learn about Essentia"
            aria-current={section === 'docs/' ? 'page' : undefined}
            ><span class="label-full">Learn about Essentia</span><span
              class="label-short">Learn</span
            ></a
          >
          <a
            href={`${base}blog/`}
            aria-current={section === 'blog/' ? 'page' : undefined}
            ><span class="label-full">Blog</span><span class="label-short"
              >Blog</span
            ></a
          >
          <a
            href={`${base}decks/`}
            aria-current={section === 'decks/' ? 'page' : undefined}
            ><span class="label-full">Decks</span><span class="label-short"
              >Decks</span
            ></a
          >
        </div>
      </nav>
      <FindPalette client:load entries={findEntries} {base} />
    </header>
    <main id="main-content"><slot /></main>
    <script
      type="application/json"
      id="keyword-rulings"
      set:html={keywordRulingsJson}
    />
    <CardHoverPreview />
    <BackToTop />
    <footer class="site-footer">
      <nav aria-label="Footer">
        <a href={`${base}legal/`}>Licence & attribution</a><a
          href={`${base}updates/`}>Card updates</a
        ><a href={`${base}feed.xml`}>Card feed</a><a
          href="https://github.com/AronGomu/YGO-x-MTG"
          rel="noopener noreferrer">GitHub repository</a
        >
      </nav>
      <p class="legal-line">
        Everything created for this project is free to use, modify, and
        redistribute, including commercially. Yu-Gi-Oh! and Magic: The Gathering
        remain property of their respective owners.
      </p>
      <CardQualityUpgrade />
    </footer>
    <script is:inline>
      // 400px is the narrowest supported width and the header must hold one
      // row there. A wrap is reported, never thrown: the page stays usable,
      // the regression is visible in the console and in `npm run build`.
      (() => {
        const check = () => {
          if (window.innerWidth > 400) return;
          const header = document.querySelector('.site-header');
          if (!header) return;
          const items = header.querySelectorAll(
            '.compact-brand, .drawer-trigger, .breadcrumb, .utility-nav, .search-trigger',
          );
          // The compact header's controls have different authored heights
          // (T5: 32px brand, ~36-44px drawer trigger, ~39px utility-more,
          // ~48-49px search trigger) and are vertically centered, so their
          // `top` differs by up to ~17px even on one visual row. Cluster
          // sorted tops instead of comparing exact rounded values: a gap
          // bigger than one row's own height variance means a real wrap.
          const tops = [];
          for (const item of items) {
            if (!item.getClientRects().length) continue;
            tops.push(item.getBoundingClientRect().top);
          }
          tops.sort((a, b) => a - b);
          let rowCount = tops.length ? 1 : 0;
          for (let i = 1; i < tops.length; i++) {
            if (tops[i] - tops[i - 1] > 20) rowCount++;
          }
          const rows = { size: rowCount };
          if (rows.size > 1) {
            console.warn(
              `[essentia] site-header wraps to ${rows.size} rows at ${window.innerWidth}px`,
            );
          }
        };
        addEventListener('load', check);
        addEventListener('resize', check);
      })();
    </script>
  </body>
</html>
