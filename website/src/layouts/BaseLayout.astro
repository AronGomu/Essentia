---
import Breadcrumb from '../components/Breadcrumb.astro';
import CardHoverPreview from '../components/CardHoverPreview.astro';
import CardQualityUpgrade from '../components/CardQualityUpgrade.astro';
import FindPalette from '../components/FindPalette.svelte';
import Navigation from '../components/Navigation.svelte';
import Seo from '../components/Seo.astro';
import { catalog } from '../lib/catalog';
import { buildFindEntries } from '../lib/find';
import { readingKindFor, readingNavGroups } from '../lib/reading-nav';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  accent?: string;
  theme?: string;
  breadcrumb?: Array<{ label: string; href?: string }>;
}
const {
  title,
  description,
  image,
  accent = 'relic',
  theme = 'archive',
  breadcrumb,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const navSections = catalog.sections.map(
  ({ slug, label, kind, route, count }) => ({
    slug,
    label,
    kind,
    route,
    count,
  }),
);
const section = ['docs/', 'blog/', 'decks/'].find((path) =>
  Astro.url.pathname.startsWith(`${base}${path}`),
);
// On docs and blog pages the left rail carries that section's reading
// navigation instead of the card catalog.
const readingKind = readingKindFor(Astro.url.pathname, base);
const readingGroups = readingNavGroups(readingKind, catalog);
// Build-time index only. The visitor's browser-local decks are merged inside
// the island after mount and never travel through here — see `src/lib/find.ts`.
const findEntries = buildFindEntries({
  cards: catalog.cards.map(
    ({ id, name, matchNames, route, sectionLabel, manifestIndex }) => ({
      id,
      name,
      matchNames,
      route,
      sectionLabel,
      manifestIndex,
    }),
  ),
  docs: catalog.docs.map(({ id, title, route, groupLabel }) => ({
    id,
    title,
    route,
    groupLabel,
  })),
  posts: catalog.posts.map(({ slug, title, route, date }) => ({
    slug,
    title,
    route,
    date,
  })),
  releases: catalog.releases.map(({ id, setName, version, route, decks }) => ({
    id,
    setName,
    version,
    route,
    decks,
  })),
});
const keywordRulings = Object.fromEntries(
  catalog.keywords
    .filter((keyword) => keyword.preview)
    .map((keyword) => [keyword.term, keyword.definition]),
);
// `set:html` writes this verbatim, so a stray `</script>` in a term or ruling
// would close the JSON block and turn the rest into live markup. `<` only ever
// occurs inside JSON string literals, where the `\u003c` escape means exactly
// the same character — the payload still parses to an identical object. The
// registry loader rejects `<` upstream; this is the second belt.
const keywordRulingsJson = JSON.stringify(keywordRulings).replaceAll(
  '<',
  '\\u003c',
);
---

<!doctype html>
<html lang="en" data-accent={accent} data-theme={theme} data-catalog="expanded">
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="oklch(0.08 0 0)" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={`${base}brand/favicon-32.png`}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href={`${base}brand/favicon-16.png`}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={`${base}brand/apple-touch-icon-180.png`}
    />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-src 'none'; manifest-src 'self'"
    />
    <Seo {title} {description} {image} />
    <script is:inline>
      try {
        if (localStorage.getItem('essentia.v1.catalog-rail') === 'collapsed')
          document.documentElement.dataset.catalog = 'collapsed';
      } catch {
        // Blocked by a privacy setting or a sandboxed context; the rail
        // simply renders expanded, its documented default.
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Navigation
      client:load
      sections={navSections}
      currentPath={Astro.url.pathname}
      {base}
      mode={readingKind ? 'reading' : 'catalog'}
      {readingKind}
      {readingGroups}
    />
    <header class="site-header">
      <a class="compact-brand" href={base}>
        <picture>
          <source
            media="(max-width: 44rem)"
            srcset={`${base}brand/mark-64.png`}
          />
          <img
            src={`${base}brand/wordmark-320.png`}
            alt="Essentia"
            width="320"
            height="74"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
      </a>
      {breadcrumb && <Breadcrumb items={breadcrumb} />}
      <nav class="utility-nav" aria-label="Sections">
        <a
          href={`${base}docs/`}
          aria-current={section === 'docs/' ? 'page' : undefined}
          >Learn about Essentia</a
        >
        <a
          href={`${base}blog/`}
          aria-current={section === 'blog/' ? 'page' : undefined}>Blog</a
        >
        <a
          href={`${base}decks/`}
          aria-current={section === 'decks/' ? 'page' : undefined}>Decks</a
        >
      </nav>
      <FindPalette client:load entries={findEntries} {base} />
    </header>
    <main id="main-content"><slot /></main>
    <script
      type="application/json"
      id="keyword-rulings"
      set:html={keywordRulingsJson}
    />
    <CardHoverPreview />
    <footer class="site-footer">
      <nav aria-label="Footer">
        <a href={`${base}legal/`}>Licence & attribution</a><a
          href={`${base}updates/`}>Card updates</a
        ><a href={`${base}feed.xml`}>Card feed</a><a
          href="https://github.com/AronGomu/YGO-x-MTG"
          rel="noopener noreferrer">GitHub repository</a
        >
      </nav>
      <p class="legal-line">
        Everything created for this project is free to use, modify, and
        redistribute, including commercially. Yu-Gi-Oh! and Magic: The Gathering
        remain property of their respective owners.
      </p>
      <CardQualityUpgrade />
    </footer>
  </body>
</html>
