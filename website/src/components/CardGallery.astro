---
import {
  isLatestRelease,
  previewImage,
  withBase,
  type GalleryCard,
} from '../lib/catalog';
import CardPicture from './CardPicture.astro';

interface Props {
  cards: GalleryCard[];
  base: string;
}

const { cards, base } = Astro.props;
const sorted = [...cards].sort((a, b) => a.name.localeCompare(b.name));
---

<div class="card-grid">
  {
    sorted.map((card, index) => (
      <a
        class="gallery-card"
        href={withBase(base, card.route)}
        data-card-preview={withBase(base, previewImage(card))}
      >
        {isLatestRelease(card) && <span class="tile-badge">New</span>}
        <CardPicture card={card} eager={index < 8} />
        <span class="card-caption">
          <strong>{card.name}</strong>
          <span>{card.superType}</span>
          {card.support && <small>Support card</small>}
        </span>
      </a>
    ))
  }
</div>
