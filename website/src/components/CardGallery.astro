---
import {
  previewKeywordsFor,
  isLatestRelease,
  previewImage,
  withBase,
  type GalleryCard,
} from '../lib/catalog';
import CardPicture from './CardPicture.astro';

interface Props {
  cards: GalleryCard[];
  base: string;
  /** Section grids flag new cards; a related block inside a card page does not. */
  showNewBadge?: boolean;
}

const { cards, base, showNewBadge = true } = Astro.props;
const sorted = [...cards].sort((a, b) => a.name.localeCompare(b.name));
---

<div class="card-grid">
  {
    sorted.map((card, index) => (
      <a
        class="gallery-card"
        href={withBase(base, card.route)}
        data-card-preview={withBase(base, previewImage(card))}
        data-card-keywords={previewKeywordsFor(card)
          .map((entry) => entry.term)
          .join(',')}
      >
        {showNewBadge && isLatestRelease(card) && (
          <span class="tile-badge">New</span>
        )}
        <CardPicture card={card} eager={index < 8} />
        <span class="card-caption">
          <strong>{card.name}</strong>
          <span>{card.superType}</span>
          {card.support && <small>Support card</small>}
        </span>
      </a>
    ))
  }
</div>
