---
import { withBase, type CardImages } from '../lib/catalog';
interface Props {
  card: { images: CardImages };
  eager?: boolean;
  sizes?: string;
  class?: string;
  alt?: string;
  /** Tier to render immediately. `thumb` pages upgrade to `display` after load. */
  tier?: 'thumb' | 'display';
}
const {
  card,
  eager = false,
  sizes = '(min-width: 70rem) 18rem, (min-width: 40rem) 30vw, 80vw',
  class: className,
  alt = '',
  tier = 'thumb',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const { thumb, display, width, height } = card.images;
const source = tier === 'display' ? display : thumb;
// Only the thumb tier has anywhere to upgrade to.
const upgrade = tier === 'thumb';
---

<picture
  class={className}
  data-card-picture={upgrade ? '' : undefined}
  data-upgrade-avif={upgrade && display.avif
    ? withBase(base, display.avif)
    : undefined}
  data-upgrade-webp={upgrade ? withBase(base, display.webp) : undefined}
>
  {
    source.avif && (
      <source srcset={withBase(base, source.avif)} type="image/avif" />
    )
  }
  <source srcset={withBase(base, source.webp)} type="image/webp" />
  <img
    src={withBase(base, source.webp)}
    alt={alt}
    width={width}
    height={height}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
    sizes={sizes}
  />
</picture>
