---
import { formatDate, withBase } from '../lib/catalog';
import { blogRailItems } from '../lib/blog-rail';

interface Props {
  posts: Array<{ slug: string; route: string; title: string; date: string }>;
  currentRoute: string | null;
  base: string;
}

const { posts, currentRoute, base } = Astro.props;
const items = blogRailItems(posts, currentRoute);
---

<nav class="reading-rail blog-rail" aria-label="Blog">
  <p class="nav-label">Blog</p>
  <ul>
    <li>
      <a
        href={withBase(base, '/blog/')}
        aria-current={currentRoute === null ? 'page' : undefined}
      >
        All posts
      </a>
    </li>
    {
      items.map((item) => (
        <li>
          <a
            href={withBase(base, item.route)}
            aria-current={item.current ? 'page' : undefined}
          >
            {item.title}
            <small>{formatDate(item.date)}</small>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
