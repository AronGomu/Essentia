<aside class="card-hover-preview" aria-hidden="true">
  <img
    class="preview-render"
    alt=""
    width="320"
    height="448"
    decoding="async"
  />
  <div class="keyword-rulings"></div>
</aside>

<script>
  import { placeHoverPreview } from '../lib/hover-placement';

  const preview = document.querySelector<HTMLElement>('.card-hover-preview');
  const previewImage = preview?.querySelector<HTMLImageElement>('img') ?? null;
  const keywordRulingsEl =
    preview?.querySelector<HTMLElement>('.keyword-rulings') ?? null;
  const rulings: Record<string, string> = JSON.parse(
    document.getElementById('keyword-rulings')?.textContent ?? '{}',
  );
  let active: HTMLElement | null = null;

  const placePreview = (target: HTMLElement) => {
    if (!preview) return;
    const rect = target.getBoundingClientRect();
    const hasRulings = preview.dataset.hasRulings === 'true';
    const placement = placeHoverPreview(
      {
        left: rect.left,
        right: rect.right,
        top: rect.top,
        height: rect.height,
      },
      { width: window.innerWidth, height: window.innerHeight },
      hasRulings,
    );
    preview.style.setProperty('--preview-left', `${placement.left}px`);
    preview.style.setProperty('--preview-top', `${placement.top}px`);
    preview.classList.toggle('is-rulings-left', placement.rulingsLeft);
    preview.classList.toggle('has-rulings', placement.showRulings);
  };

  const showPreview = (target: HTMLElement) => {
    const src = target.dataset.cardPreview;
    if (!preview || !previewImage || !src) return;
    active = target;
    previewImage.src = src;

    if (keywordRulingsEl) {
      keywordRulingsEl.replaceChildren();
      const terms = (target.dataset.cardKeywords ?? '')
        .split(',')
        .filter((term) => term !== '');
      for (const term of terms) {
        const definition = rulings[term];
        if (definition === undefined) continue;
        const p = document.createElement('p');
        p.className = 'keyword-ruling';
        const strong = document.createElement('strong');
        strong.textContent = term;
        p.append(strong, document.createTextNode(` ${definition}`));
        keywordRulingsEl.append(p);
      }
    }

    preview.dataset.hasRulings = String(
      (keywordRulingsEl?.childElementCount ?? 0) > 0,
    );
    preview.classList.add('is-visible');
    placePreview(target);
  };

  const hidePreview = (target: HTMLElement) => {
    if (!preview || active !== target) return;
    active = null;
    preview.classList.remove('is-visible');
  };

  document.addEventListener('pointerover', (event) => {
    if (!(event.target instanceof Element)) return;
    const target = event.target.closest<HTMLElement>('[data-card-preview]');
    if (target) showPreview(target);
  });
  document.addEventListener('pointerout', (event) => {
    if (!(event.target instanceof Element)) return;
    const target = event.target.closest<HTMLElement>('[data-card-preview]');
    if (target && !target.contains(event.relatedTarget as Node)) {
      hidePreview(target);
    }
  });
  document.addEventListener('focusin', (event) => {
    if (!(event.target instanceof Element)) return;
    const target = event.target.closest<HTMLElement>('[data-card-preview]');
    if (target) showPreview(target);
  });
  document.addEventListener('focusout', (event) => {
    if (!(event.target instanceof Element)) return;
    const target = event.target.closest<HTMLElement>('[data-card-preview]');
    if (target && !target.contains(event.relatedTarget as Node)) {
      hidePreview(target);
    }
  });
  window.addEventListener(
    'scroll',
    () => {
      if (active) placePreview(active);
    },
    { passive: true },
  );
  window.addEventListener('resize', () => {
    if (active) placePreview(active);
  });
</script>
