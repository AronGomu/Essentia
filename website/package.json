{
  "name": "ygo-mtg-showcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run cards:rebuild && node scripts/build-content.mjs && astro dev",
    "cards:rebuild": "\"${PYTHON:-python}\" ../.script/rebuild_open_packages.py",
    "build": "node scripts/build-content.mjs && astro build && node scripts/harden-csp.mjs && node scripts/scan-dist.mjs && node scripts/check-404.mjs && node scripts/check-chrome.mjs && node scripts/check-header-row.mjs",
    "preview": "astro preview",
    "check": "node scripts/build-content.mjs && astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preflight": "node scripts/check-preflight.mjs",
    "hero:art": "node scripts/make-hero-art.mjs",
    "backgrounds:art": "node scripts/make-archetype-backgrounds.mjs",
    "brand:assets": "node scripts/make-brand-assets.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content": "node scripts/build-content.mjs",
    "content:check": "node scripts/build-content.mjs --check",
    "immutability:check": "\"${PYTHON:-python}\" ../.script/check_immutable_stages.py",
    "links:check": "node scripts/check-links.mjs",
    "budgets:check": "node scripts/check-budgets.mjs",
    "audit:deps": "npm audit --audit-level=high && npm run install-scripts:check && npm run licenses:check",
    "install-scripts:check": "node scripts/check-install-scripts.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "rights:check": "node scripts/check-rights.mjs",
    "ci": "npm run format:check && npm run lint && npm run check && npm run test && npm run build"
  },
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "astro": "7.1.5",
    "sharp": "0.35.3",
    "svelte": "5.56.8"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.2",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "3.0.1",
    "eslint-plugin-svelte": "3.22.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-svelte": "4.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
